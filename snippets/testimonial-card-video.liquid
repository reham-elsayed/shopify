<article class="editorial-testimonial__card editorial-testimonial__card--video" data-testimonial-card data-testimonial-category="{{ block.settings.category | default: 'video' }}">
  <div class="editorial-testimonial__video">
    {% if block.settings.video != blank %}
      {{ block.settings.video | video_tag: controls: true, preload: 'metadata', image_size: '900x' }}
    {% elsif block.settings.video_url != blank %}
      <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}" title="Video testimonial from {{ block.settings.author | escape }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    {% elsif block.settings.image != blank %}
      {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '320, 480, 640, 800, 1000', sizes: '(min-width: 990px) 30vw, 82vw', alt: block.settings.author | escape }}
    {% endif %}
  </div>
  <div class="editorial-testimonial__card-body">
    <span class="editorial-testimonial__eyebrow">Watch their story</span>
    <blockquote class="editorial-testimonial__quote">{{ block.settings.quote | escape }}</blockquote>
    <p class="editorial-testimonial__author-line">{{ block.settings.author | escape }}{% if block.settings.verified %} <span class="editorial-testimonial__verified">✓ Verified purchaser</span>{% endif %}</p>
  </div>
</article>
