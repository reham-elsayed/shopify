{% comment %}
  Accepts:
  - blocks: {Array} section.blocks (Required)
  - card_styles: {String} section.settings.card_styles
  - mobile_layout: {String}
  - section_id: {String}
  - gapless_grid: {Boolean}
{% endcomment %}

{%- liquid
  assign skip_card_product_styles = false
  assign magazine_video_block = blocks | where: 'type', 'video' | first

  assign row_1_classes = 'grid--3-col-desktop page-width-full grid grid--1-col-tablet-down grid-for-' | append: section_id

  if blocks.size == 4
    assign row_2_classes = 'grid grid--2-col-desktop  page-width section-{{ section.id }}-padding  section-{{ section.id }}-padding grid--1-col-tablet-down grid-for-' | append: section_id
  elsif blocks.size == 5
    assign row_2_classes = 'grid grid--3-col-desktop page-width  section-{{ section.id }}-padding section-{{ section.id }}-padding grid--1-col-tablet-down grid-for-' | append: section_id
  else
    assign row_2_classes = 'grid grid--4-col-desktop  section-{{ section.id }}-padding grid--1-col-tablet-down grid-for-' | append: section_id
  endif

  if gapless_grid
    assign row_1_classes = row_1_classes | append: ' grid--gapless'
    assign row_2_classes = row_2_classes | append: ' grid--gapless'
  endif
-%}

{% comment %} --- ROW 1: 3-column grid (Video 2/3 + First Card 1/3) --- {% endcomment %}
<div
  class="{{ row_1_classes }}"
  id="Grid-Row1-{{ section_id }}{% if mobile_layout == 'collage' %} editorial-grid--mobile-collage{% endif %}"
>
  {% comment %} Video Block (Two-Thirds) {% endcomment %}
  {%- if magazine_video_block -%}
    <div
      class="grid__item grid__item--two-thirds {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      {{ magazine_video_block.shopify_attributes }}
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
        style="--animation-order: 0;"
      {% endif %}
    >
      {%- if magazine_video_block.settings.editorial_video != blank -%}
        <div class="collage-card magazine-cinematic-card {% if card_styles == 'none' %}global-media-settings{% else %}{{ card_styles }} color-{{ settings.card_color_scheme }} gradient{% endif %}">
          <div class="video-media-wrapper" style="position: relative; width: 100%; height: 100%; overflow: hidden;">
            {{
              magazine_video_block.settings.editorial_video
              | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true
            }}
            <div
              class="video-subtle-overlay"
              style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to top, rgba(0,0,0,0.4), transparent); z-index: 1;"
            ></div>
          </div>
          <div
            class="magazine-card-overlay-content"
            style="position: absolute; bottom: 0; left: 0; width: 100%; padding: 25px; color: #fff; z-index: 2;"
          >
            <span
              class="magazine-subheading"
              style="display: block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 5px;"
            >
              New Season
            </span>
            <h2 class="magazine-heading" style="margin: 0 0 10px 0; color: #fff;">The Autumn Editorial</h2>
          </div>
        </div>
      {%- else -%}
        {% comment %} Video placeholder – shown in the editor when no video has been uploaded {% endcomment %}
        <div
          class="collage-card magazine-cinematic-card magazine-video-placeholder {% if card_styles == 'none' %}global-media-settings{% else %}{{ card_styles }} color-{{ settings.card_color_scheme }} gradient{% endif %}"
          style="display: flex; align-items: center; justify-content: center; min-height: 400px; border: 2px dashed rgba(128,128,128,0.4); border-radius: 4px; background: rgba(0,0,0,0.03);"
        >
          <div style="text-align: center; color: currentColor; opacity: 0.5;">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="display: block; margin: 0 auto 12px;"
            >
              <circle cx="12" cy="12" r="10"/>
              <polygon points="10 8 16 12 10 16 10 8"/>
            </svg>
            <p style="margin: 0; font-size: 0.9rem; letter-spacing: 0.05em;">
              {{ 'sections.editorial.video_placeholder' | t: default: 'Add a video to this block' }}
            </p>
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {% comment %} First Standard Block (One-Third) {% endcomment %}
  {%- assign first_card_rendered = false -%}
  {%- for block in blocks -%}
    {%- if block == magazine_video_block -%}{%- continue -%}{%- endif -%}

    {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
    <div
      class="grid__item grid__item--one-third {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      {{ block.shopify_attributes }}
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
        style="--animation-order: 1;"
      {% endif %}
    >
      {% render 'editorial-card',
        block: block,
        placeholder_image_index: placeholder_image_index,
        card_styles: card_styles,
        layout_style: 'magazine',
        mobile_layout: mobile_layout,
        skip_card_product_styles: skip_card_product_styles,
        large_block: false
      %}
    </div>
    {%- assign first_card_rendered = true -%}
    {%- break -%}
    {% comment %} Stop after 1st card {% endcomment %}
  {%- endfor -%}
</div>

{% comment %} --- ROW 2: 4-column grid (Remaining Cards) --- {% endcomment %}
<div class=" page-width section-{{ section.id }}-padding">
  <div
    class="{{ row_2_classes }}"
    style="margin-top: var(--grid-desktop-vertical-spacing);"
    id="Grid-Row2-{{ section_id }}{% if mobile_layout == 'collage' %} editorial-grid--mobile-collage{% endif %}"
  >
    {%- assign cards_skipped = 0 -%}
    {%- for block in blocks -%}
      {%- if block == magazine_video_block -%}{%- continue -%}{%- endif -%}

      {%- assign cards_skipped = cards_skipped | plus: 1 -%}
      {%- if cards_skipped == 1 -%}{%- continue -%}{%- endif -%}
      {% comment %} Skip the one already rendered in Row 1 {% endcomment %}

      {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
      <div
        class="grid__item {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {{ block.shopify_attributes }}
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
          style="--animation-order: {{ cards_skipped }};"
        {% endif %}
      >
        {% render 'editorial-card',
          block: block,
          placeholder_image_index: placeholder_image_index,
          card_styles: card_styles,
          layout_style: 'magazine',
          mobile_layout: mobile_layout,
          skip_card_product_styles: skip_card_product_styles,
          large_block: false
        %}
      </div>
    {%- endfor -%}
  </div>
</div>
