{% comment %}
  Accepts:
  - blocks: {Array} section.blocks (Required)
  - mobile_layout: {String} 'collage' | 'stacked'
  - card_styles: {String} section.settings.card_styles
  - video_url: {Object} section.settings.video_url (Optional)
  - cover_image: {Object} section.settings.cover_image (Optional)
{% endcomment %}

<div class="editorial-grid-wrapper editorial-grid-wrapper--vintage">
  {%- if video_url != blank -%}
    <div class="gallery-row-banner" style="width: 100%; margin-bottom: 0;">
      <deferred-media
        class="deferred-media no-js-hidden media media--transparent ratio"
        data-media-id="{{ video_url.id }}"
        style="--ratio-percent: 42%;"
      >
        <button
          id="Deferred-Poster-Modal-{{ video_url.id }}"
          class="deferred-media__poster"
          type="button"
        >
          {%- if cover_image != blank -%}
            {{
              cover_image
              | image_url: width: 3000
              | image_tag: loading: 'lazy', sizes: '100vw', widths: '375, 550, 750, 1100, 1500, 2000, 3000'
            }}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
          {%- endif -%}
          <span class="deferred-media__poster-button motion-reduce">
            <span class="svg-wrapper">
              {{- 'icon-play.svg' | inline_asset_content -}}
            </span>
          </span>
        </button>
        <template>
          {%- if video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ video_url.id }}?enablejsapi=1&autoplay=1&mute=1"
              class="js-youtube"
              allow="autoplay; encrypted-media"
              allowfullscreen
            ></iframe>
          {%- else -%}
            <iframe
              src="https://player.vimeo.com/video/{{ video_url.id }}?autoplay=1&muted=1"
              class="js-vimeo"
              allow="autoplay; encrypted-media"
              allowfullscreen
            ></iframe>
          {%- endif -%}
        </template>
      </deferred-media>
    </div>
  {%- endif -%}

  <div class="editorial-grid editorial-grid--vintage{% if mobile_layout == 'collage' %} editorial-grid--mobile-collage{% endif %}">
    {%- assign skip_card_product_styles = false -%}
    {%- for block in blocks -%}
      <div
        class="editorial-grid__item editorial-grid__item--vintage"
        {{ block.shopify_attributes }}
      >
        {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
        {%- case block.type -%}
          {%- when 'image' -%}
            <div class="collage-card {% if card_styles == 'none' %}global-media-settings{% else %}card-wrapper {{ card_styles }} color-{{ settings.card_color_scheme }} gradient{% endif %}">
              <div
                class="media media--transparent ratio"
                {% if block.settings.image != blank %}
                  style="--ratio-percent: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%"
                {% else %}
                  style="--ratio-percent: 100%"
                {% endif %}
              >
                {%- if block.settings.image != blank -%}
                  {%- capture sizes -%}
                    (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - 100px) / 2),
                    (min-width: 750px) calc((100vw - 100px) / 2),
                    calc(100vw - 30px)
                  {%- endcapture -%}
                  {{
                    block.settings.image
                    | image_url: width: 2000
                    | image_tag: sizes: sizes, widths: '375, 550, 750, 1100, 1500, 1750, 2000'
                  }}
                {%- else -%}
                  {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </div>

          {%- when 'product' -%}
            {% render 'card-product',
              card_product: block.settings.product,
              media_aspect_ratio: 'adapt',
              show_secondary_image: block.settings.second_image,
              extend_height: true,
              placeholder_image: 'product-apparel-1',
              skip_styles: skip_card_product_styles
            %}
            {%- assign skip_card_product_styles = true -%}

          {%- when 'collection' -%}
            {% render 'card-collection',
              card_collection: block.settings.collection,
              media_aspect_ratio: 'adapt',
              columns: 2,
              extend_height: true,
              wrapper_class: card_styles,
              placeholder_image: 'collection-apparel-1'
            %}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</div>
