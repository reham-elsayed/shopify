{% comment %}
  Accepts:
  - blocks: {Array} section.blocks (Required)
  - card_styles: {String} section.settings.card_styles
  - mobile_layout: {String}
  - section_id: {String}
  - gapless_grid: {Boolean}
{% endcomment %}

{%- liquid
  assign vintage_video_block = blocks | where: 'type', 'video' | first

  assign row_1_classes = 'grid--1-col-desktop grid grid--1-col-tablet-down grid-for-' | append: section_id

  if blocks.size == 3
    assign row_2_classes = 'grid--2-col-desktop grid grid--2-col-tablet-down grid-for-' | append: section_id
  elsif blocks.size == 4
    assign row_2_classes = 'grid--3-col-desktop  grid grid--2-col-tablet-down grid-for-' | append: section_id
  else
    assign row_2_classes = 'grid--4-col-desktop grid grid--2-col-tablet-down grid-for-' | append: section_id
  endif

  if gapless_grid
    assign row_1_classes = row_1_classes | append: ' grid--gapless'
    assign row_2_classes = row_2_classes | append: ' grid--gapless'
  endif
-%}

<div
  class="{{ row_1_classes }}{% if mobile_layout == 'collage' %} editorial-grid--mobile-collage{% endif %}"
  id="Grid-Row1-{{ section_id }}"
>
  {% comment %} Video Block (Two-Thirds) {% endcomment %}
  {%- if vintage_video_block -%}
    <div
      class="grid__item  {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      {{ vintage_video_block.shopify_attributes }}
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
        style="--animation-order: 0;"
      {% endif %}
    >
      {%- if vintage_video_block.settings.editorial_video != blank -%}
        <div class="collage-card vintage-cinematic-card {% if card_styles == 'none' %}global-media-settings{% else %}{{ card_styles }} color-{{ settings.card_color_scheme }} gradient{% endif %}">
          <div class="video-media-wrapper" style="position: relative; width: 100%; height: 100%; overflow: hidden;">
            {{
              vintage_video_block.settings.editorial_video
              | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true
            }}
            <div
              class="video-subtle-overlay"
              style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to top, rgba(0,0,0,0.4), transparent); z-index: 1;"
            ></div>
          </div>
          <div
            class="vintage-card-overlay-content"
            style="position: absolute; bottom: 0; left: 0; width: 100%; padding: 25px; color: #fff; z-index: 2;"
          >
            <span
              class="vintage-subheading"
              style="display: block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 5px;"
            >
              New Season
            </span>
            <h2 class="vintage-heading" style="margin: 0 0 10px 0; color: #fff;">The Autumn Editorial</h2>
          </div>
        </div>
      {%- else -%}
        {% comment %} Video placeholder – shown in the editor when no video has been uploaded {% endcomment %}
        <div
          class="collage-card vintage-cinematic-card vintage-video-placeholder {% if card_styles == 'none' %}global-media-settings{% else %}{{ card_styles }} color-{{ settings.card_color_scheme }} gradient{% endif %}"
          style="display: flex; align-items: center; justify-content: center; min-height: 400px; border: 2px dashed rgba(128,128,128,0.4); border-radius: 4px; background: rgba(0,0,0,0.03);"
        >
          <div style="text-align: center; color: currentColor; opacity: 0.5;">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="display: block; margin: 0 auto 12px;"
            >
              <circle cx="12" cy="12" r="10"/>
              <polygon points="10 8 16 12 10 16 10 8"/>
            </svg>
            <p style="margin: 0; font-size: 0.9rem; letter-spacing: 0.05em;">
              {{ 'sections.editorial.video_placeholder' | t: default: 'Add a video to this block' }}
            </p>
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {% comment %}
    {%- assign first_card_rendered = false -%}
    {%- for block in blocks -%}
      {%- if block == vintage_video_block -%}{%- continue -%}{%- endif -%}

      {% assign placeholder_image_index = forloop.index0 | modulo: 3 | plus: 1 %}

      {%- first_card_rendered = true -%}

      {%- break -%}
      {% comment %} Stop after 1st card {% endcomment %}
    {%- endfor -%}
  {% endcomment %}
</div>

{% comment %} --- ROW 2: 4-column grid (Remaining Cards) --- {% endcomment %}
<div class="page-width page-width--flush" style="margin-top: 0px; margin-bottom: 0px;">
  <div
    class="{{ row_2_classes }}{% if mobile_layout == 'collage' %} editorial-grid--mobile-collage{% endif %}"
    id="Grid-Row2-{{ section_id }}"
  >
    {%- assign cards_skipped = 0 -%}
    {%- for block in blocks -%}
      {%- if block == vintage_video_block -%}{%- continue -%}{%- endif -%}

      {% comment %}
        {%- assign cards_skipped = cards_skipped | plus: 1 -%}
        {%- if cards_skipped == 1 -%}{%- continue -%}{%- endif -%}
      {% endcomment %}
      {% comment %} Skip the one already rendered in Row 1 {% endcomment %}

      {%- assign placeholder_image_index = forloop.index0 | modulo: 3 | plus: 1 -%}
      <div
        class="grid__item   {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {{ block.shopify_attributes }}
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
          style="--animation-order: {{ cards_skipped }};"
        {% endif %}
      >
        <div
          class="
            {% assign remainder = forloop.index | modulo: 2 %}
            {% if remainder == 1 %}
              vintage-card--height
            {% else %}
              vintage-card--height
            {% endif %}
          "
        >
          {% render 'editorial-card',
            block: block,
            placeholder_image_index: placeholder_image_index,
            card_styles: card_styles,
            layout_style: 'vintage',
            mobile_layout: mobile_layout,
            skip_card_product_styles: skip_card_product_styles,
            large_block: false
          %}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
