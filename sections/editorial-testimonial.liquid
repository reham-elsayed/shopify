{{ 'editorial-testimonial.css' | asset_url | stylesheet_tag }}
<script src="{{ 'editorial-testimonial.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}

{%- liquid
  assign has_products = false
  assign has_video = false
  assign has_results = false
  assign has_community = false
  for block in section.blocks
    case block.settings.category
      when 'products'
        assign has_products = true
      when 'video'
        assign has_video = true
      when 'results'
        assign has_results = true
      else
        assign has_community = true
    endcase
  endfor
-%}

<div class="editorial-testimonial color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding isolate">
    <editorial-testimonial>
      <div class="editorial-testimonial__header">
        <div>
          {% if section.settings.eyebrow != blank %}<p class="editorial-testimonial__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
          {% if section.settings.heading != blank %}<h2 class="editorial-testimonial__heading inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>{% endif %}
        </div>
        {% if section.settings.text != blank %}<div class="editorial-testimonial__intro rte">{{ section.settings.text }}</div>{% endif %}
        {% if section.settings.enable_filters and section.blocks.size > 1 %}
          <div class="editorial-testimonial__filters" role="group" aria-label="Filter testimonials">
            <button class="editorial-testimonial__filter" type="button" data-testimonial-filter="all" aria-pressed="true">All stories</button>
            {% if has_community %}<button class="editorial-testimonial__filter" type="button" data-testimonial-filter="community" aria-pressed="false">Community</button>{% endif %}
            {% if has_products %}<button class="editorial-testimonial__filter" type="button" data-testimonial-filter="products" aria-pressed="false">Product love</button>{% endif %}
            {% if has_video %}<button class="editorial-testimonial__filter" type="button" data-testimonial-filter="video" aria-pressed="false">Video stories</button>{% endif %}
            {% if has_results %}<button class="editorial-testimonial__filter" type="button" data-testimonial-filter="results" aria-pressed="false">Results</button>{% endif %}
          </div>
        {% endif %}
      </div>
      <p class="editorial-testimonial__status visually-hidden" data-testimonial-status aria-live="polite">{{ section.blocks.size }} testimonials shown</p>
      <div class="editorial-testimonial__grid" role="list" aria-label="Customer testimonials">
        {% for block in section.blocks %}
          <div class="editorial-testimonial__item" role="listitem" {{ block.shopify_attributes }}>
            {% case block.type %}
              {% when 'quote' %}{% render 'testimonial-card-quote', block: block %}
              {% when 'product' %}{% render 'testimonial-card-product', block: block %}
              {% when 'video' %}{% render 'testimonial-card-video', block: block %}
              {% when 'instagram' %}{% render 'testimonial-card-instagram', block: block %}
              {% when 'before_after' %}{% render 'testimonial-card-before-after', block: block %}
            {% endcase %}
          </div>
        {% else %}
          <div class="editorial-testimonial__item" role="listitem">
            <article class="editorial-testimonial__card editorial-testimonial__card--quote"><div class="editorial-testimonial__card-body"><p class="editorial-testimonial__rating" aria-label="5 out of 5 stars">★★★★★</p><blockquote class="editorial-testimonial__quote">Add testimonial cards to share real customer stories.</blockquote></div></article>
          </div>
        {% endfor %}
      </div>
    </editorial-testimonial>
  </div>
</div>

{% schema %}
{
  "name": "Editorial testimonials",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The community edit" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Stories worth sharing" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "h1", "options": [{ "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" }] },
    { "type": "richtext", "id": "text", "label": "Description", "default": "<p>A living collection of reviews, rituals, and real results from our community.</p>" },
    { "type": "checkbox", "id": "enable_filters", "label": "Enable testimonial filters", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "quote", "name": "Quote card", "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "It feels like it was made for my everyday routine." },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Alex M." },
        { "type": "text", "id": "location", "label": "Location" },
        { "type": "image_picker", "id": "avatar", "label": "Customer photo" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Verified purchaser", "default": true },
        { "type": "select", "id": "category", "label": "Filter category", "default": "community", "options": [{ "value": "community", "label": "Community" }, { "value": "products", "label": "Product love" }, { "value": "results", "label": "Results" }] }
      ]
    },
    {
      "type": "product", "name": "Product-linked card", "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }, { "type": "textarea", "id": "quote", "label": "Quote", "default": "A little luxury that makes a big difference." }, { "type": "text", "id": "author", "label": "Customer name", "default": "Maya R." }, { "type": "product", "id": "product", "label": "Linked product" }, { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 1, "default": 5 }, { "type": "checkbox", "id": "verified", "label": "Verified purchaser", "default": true }, { "type": "select", "id": "category", "label": "Filter category", "default": "products", "options": [{ "value": "products", "label": "Product love" }, { "value": "community", "label": "Community" }, { "value": "results", "label": "Results" }] }
      ]
    },
    {
      "type": "video", "name": "Video testimonial", "settings": [
        { "type": "video", "id": "video", "label": "Shopify-hosted video" }, { "type": "video_url", "id": "video_url", "label": "YouTube video", "accept": ["youtube"], "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc" }, { "type": "image_picker", "id": "image", "label": "Fallback image" }, { "type": "textarea", "id": "quote", "label": "Quote", "default": "My new non-negotiable. I love how simple it is." }, { "type": "text", "id": "author", "label": "Customer name", "default": "Jordan K." }, { "type": "checkbox", "id": "verified", "label": "Verified purchaser", "default": true }, { "type": "select", "id": "category", "label": "Filter category", "default": "video", "options": [{ "value": "video", "label": "Video stories" }, { "value": "community", "label": "Community" }] }
      ]
    },
    {
      "type": "instagram", "name": "Community gallery card", "settings": [
        { "type": "image_picker", "id": "image", "label": "Community image" }, { "type": "text", "id": "handle", "label": "Social handle", "default": "@yourcommunity" }, { "type": "textarea", "id": "caption", "label": "Caption", "default": "Sunday reset, featuring my favorite essentials." }, { "type": "url", "id": "link", "label": "Post link" }, { "type": "select", "id": "category", "label": "Filter category", "default": "community", "options": [{ "value": "community", "label": "Community" }, { "value": "products", "label": "Product love" }] }
      ]
    },
    {
      "type": "before_after", "name": "Before and after card", "settings": [
        { "type": "image_picker", "id": "before_image", "label": "Before image" }, { "type": "image_picker", "id": "after_image", "label": "After image" }, { "type": "textarea", "id": "quote", "label": "Quote", "default": "The difference after a few weeks was impossible to miss." }, { "type": "text", "id": "author", "label": "Customer name", "default": "Taylor S." }, { "type": "checkbox", "id": "verified", "label": "Verified purchaser", "default": true }, { "type": "select", "id": "category", "label": "Filter category", "default": "results", "options": [{ "value": "results", "label": "Results" }, { "value": "community", "label": "Community" }] }
      ]
    }
  ],
  "presets": [{ "name": "Editorial testimonials", "blocks": [{ "type": "quote" }, { "type": "product" }, { "type": "instagram" }, { "type": "before_after" }, { "type": "video" }] }]
}
{% endschema %}
