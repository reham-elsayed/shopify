{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'shop-the-look.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign hero_image = section.settings.main_image
  assign grid_space_desktop = settings.spacing_grid_horizontal | divided_by: 2 | append: 'px'
  assign grid_space_mobile = settings.spacing_grid_horizontal | divided_by: 4 | append: 'px'
-%}

<div class="shop-the-look color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="shop-the-look-title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- comment -%}
      =====================================================================
      DESKTOP LAYOUT  (≥990px)
      Three-column flex: left products | central hero | right products
      =====================================================================
    {%- endcomment -%}
    <div class="shop-the-look__canvas--desktop">
      {%- comment -%} LEFT COLUMN — odd product blocks (1st, 3rd, 5th …) {%- endcomment -%}
      <div class="stl-left-col">
        {% assign skip_card_product_styles = false %}
        {%- for block in section.blocks -%}
          {%- assign mod_val = forloop.index | modulo: 2 -%}
          {%- if mod_val == 1 -%}
            <div
              class="collage__item collage__item--product{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
              {%- assign placeholder_image = 'product-apparel-' | append: placeholder_image_index -%}
              {% render 'card-product',
                card_product: block.settings.product,
                media_aspect_ratio: 'adapt',
                show_secondary_image: block.settings.second_image,
                extend_height: true,
                placeholder_image: placeholder_image,
                skip_styles: skip_card_product_styles
              %}
              {% assign skip_card_product_styles = true %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} CENTRE COLUMN — sticky hero image {%- endcomment -%}
      <div class="stl-hero-col">
        <div class="shop-the-look__hero">
          <div class="collage-card global-media-settings">
            <div
              class="media media--transparent ratio"
              {% if hero_image != blank %}
                style="--ratio-percent: {{ 1 | divided_by: hero_image.aspect_ratio | times: 100 }}%"
              {% else %}
                style="--ratio-percent: 100%"
              {% endif %}
            >
              {%- if hero_image != blank -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - 100px) * 0.4 - {{ grid_space_desktop }}),
                  (min-width: 750px) calc(40vw - {{ grid_space_desktop }}),
                  calc(100vw - 30px)
                {%- endcapture -%}
                {{
                  hero_image
                  | image_url: width: 3200
                  | image_tag:
                    sizes: sizes,
                    widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                    class: 'shop-the-look__hero-image'
                }}
              {%- else -%}
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} RIGHT COLUMN — even product blocks (2nd, 4th, 6th …) {%- endcomment -%}
      <div class="stl-right-col">
        {%- for block in section.blocks -%}
          {%- assign mod_val = forloop.index | modulo: 2 -%}
          {%- if mod_val == 0 -%}
            <div
              class="collage__item collage__item--product{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
              {%- assign placeholder_image = 'product-apparel-' | append: placeholder_image_index -%}
              {% render 'card-product',
                card_product: block.settings.product,
                media_aspect_ratio: 'adapt',
                show_secondary_image: block.settings.second_image,
                extend_height: true,
                placeholder_image: placeholder_image,
                skip_styles: skip_card_product_styles
              %}
              {% assign skip_card_product_styles = true %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%}
      =====================================================================
      MOBILE LAYOUT  (<990px)
      Hero image stacked above a horizontal product slider
      =====================================================================
    {%- endcomment -%}
    <div class="shop-the-look__mobile-wrapper">
      {%- comment -%} Mobile hero {%- endcomment -%}
      <div class="shop-the-look__hero--mobile">
        <div
          class="media media--transparent ratio"
          {% if hero_image != blank %}
            style="--ratio-percent: {{ 1 | divided_by: hero_image.aspect_ratio | times: 100 }}%"
          {% else %}
            style="--ratio-percent: 100%"
          {% endif %}
        >
          {%- if hero_image != blank -%}
            {%- capture sizes -%}
              calc(100vw - 30px)
            {%- endcapture -%}
            {{
              hero_image
              | image_url: width: 3200
              | image_tag:
                sizes: sizes,
                widths: '200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                class: 'shop-the-look__hero-image'
            }}
          {%- else -%}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Mobile product slider {%- endcomment -%}
      <slideshow-component>
        <div class="shop-the-look__slider-track" role="list">
          {% assign skip_card_product_styles_mobile = false %}
          {%- for block in section.blocks -%}
            <div
              class="lookbook-product--slide"
              role="listitem"
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
              {%- assign placeholder_image = 'product-apparel-' | append: placeholder_image_index -%}
              {% render 'card-product',
                card_product: block.settings.product,
                media_aspect_ratio: 'adapt',
                show_secondary_image: block.settings.second_image,
                extend_height: true,
                placeholder_image: placeholder_image,
                skip_styles: skip_card_product_styles_mobile
              %}
              {% assign skip_card_product_styles_mobile = true %}
            </div>
          {%- endfor -%}
        </div>

        <div class="slideshow__controls slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t  }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="slider-counter slider-counter--dots">
            <div class="slideshow__control-wrapper">
              {%- for block in section.blocks -%}
                <button
                  class="slider-counter__link--dots{% if forloop.first %} active{% endif %}"
                  aria-label="{{ 'sections.slideshow.slide' | t: number: forloop.index }}"
                  {% if forloop.first %}
                    aria-current="true"
                  {% endif %}
                >
                  <span class="dot"></span>
                </button>
              {%- endfor -%}
            </div>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </slideshow-component>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial Shop The Look",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Model Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop The Look"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Look Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "show_info",
          "label": "Show product info",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop The Look",
      "blocks": [
        { "type": "product", "settings": {} },
        { "type": "product", "settings": {} },
        { "type": "product", "settings": {} },
        { "type": "product", "settings": {} }
      ]
    }
  ]
}
{% endschema %}
