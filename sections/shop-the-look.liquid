{{ 'shop-the-look.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  class="shop-the-look"
  aria-label="{{ section.settings.heading | escape | default: 'Shop The Look' }}"
>
  <div class="shop-the-look__container page-width isolate section-{{ section.id }}-padding">

    {% if section.settings.heading != blank %}
      <h2 class="shop-the-look__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="shop-the-look__subheading">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    {%- comment -%}
      ============================================================
      DESKTOP LAYOUT  (≥990px)

      Three explicit column wrappers:
        .stl-left-col  — odd  products: 1st, 3rd, 5th, 7th
        .stl-hero-col  — model hero image (position:sticky)
        .stl-right-col — even products: 2nd, 4th, 6th, 8th

      The hero is position:sticky so it stays locked to the
      vertical centre of the viewport while both product columns
      scroll naturally past it on either side.

      Supports 3 – 8 product blocks without layout changes.
      ============================================================
    {%- endcomment -%}

    <div
      class="shop-the-look__canvas shop-the-look__canvas--desktop"
      data-count="{{ section.blocks.size }}"
      role="region"
      aria-label="Shop the look — product grid"
    >

      {%- comment -%} ── LEFT COLUMN: products at index 0, 2, 4, 6 (1st, 3rd, 5th, 7th) ── {%- endcomment -%}
      <div class="stl-left-col" aria-label="Products — left column">
        {% for block in section.blocks %}
          {%- assign product = block.settings.product -%}
          {%- assign col_index = forloop.index0 | modulo: 2 -%}
          {% if col_index == 0 and product != blank %}
            <article
              class="lookbook-product lookbook-product--desktop"
              {{ block.shopify_attributes }}
              aria-label="{{ product.title | escape }}"
            >
              <a
                href="{{ product.url }}"
                class="lookbook-product__image-link"
                aria-label="View {{ product.title | escape }}"
                tabindex="0"
              >
                {% if product.featured_media %}
                  <img
                    srcset="
                      {%- if product.featured_media.preview_image.width >= 300 -%}{{ product.featured_media.preview_image | image_url: width: 300 }} 300w,{%- endif -%}
                      {%- if product.featured_media.preview_image.width >= 500 -%}{{ product.featured_media.preview_image | image_url: width: 500 }} 500w,{%- endif -%}
                      {%- if product.featured_media.preview_image.width >= 800 -%}{{ product.featured_media.preview_image | image_url: width: 800 }} 800w,{%- endif -%}
                      {{ product.featured_media.preview_image | image_url }} {{ product.featured_media.preview_image.width }}w
                    "
                    src="{{ product.featured_media.preview_image | image_url: width: 500 }}"
                    sizes="(min-width: 990px) 28vw, 50vw"
                    alt="{{ product.featured_media.preview_image.alt | escape | default: product.title }}"
                    class="lookbook-product__image"
                    loading="lazy"
                    width="{{ product.featured_media.preview_image.width }}"
                    height="{{ product.featured_media.preview_image.height }}"
                  >
                {% else %}
                  <div class="lookbook-product__image-placeholder" aria-hidden="true"></div>
                {% endif %}
              </a>

              {% if block.settings.show_info %}
                <div class="shop-the-look__info lookbook-product__overlay content-container color-{{ section.settings.color_scheme | default: 'scheme-1' }} gradient">
                  <h3 class="shop-the-look__title h2" title="{{ product.title | escape }}">
                    {{ product.title }}
                  </h3>
                  <div class="shop-the-look__price">
                    {{ product.price | money }}
                  </div>
                  {% if product.selected_or_first_available_variant %}
                    <form method="post" action="{{ routes.cart_add_url }}">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <div class="card_actions-container">
                        <button
                          type="submit"
                          class="button button--primary button--full-width"
                          aria-label="Add {{ product.title | escape }} to cart"
                        >
                          Add to cart
                        </button>
                      </div>
                    </form>
                  {% endif %}
                </div>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>

      {%- comment -%} ── HERO COLUMN: sticky model image ── {%- endcomment -%}
      <div class="stl-hero-col">
        {% if section.settings.main_image != blank %}
          <div class="shop-the-look__hero" aria-hidden="true">
            <img
              srcset="
                {%- if section.settings.main_image.width >= 360 -%}{{ section.settings.main_image | image_url: width: 360 }} 360w,{%- endif -%}
                {%- if section.settings.main_image.width >= 540 -%}{{ section.settings.main_image | image_url: width: 540 }} 540w,{%- endif -%}
                {%- if section.settings.main_image.width >= 720 -%}{{ section.settings.main_image | image_url: width: 720 }} 720w,{%- endif -%}
                {%- if section.settings.main_image.width >= 1080 -%}{{ section.settings.main_image | image_url: width: 1080 }} 1080w,{%- endif -%}
                {%- if section.settings.main_image.width >= 1600 -%}{{ section.settings.main_image | image_url: width: 1600 }} 1600w,{%- endif -%}
                {{ section.settings.main_image | image_url }} {{ section.settings.main_image.width }}w
              "
              src="{{ section.settings.main_image | image_url: width: 1080 }}"
              sizes="(min-width: 990px) 40vw, 100vw"
              alt="{{ section.settings.main_image.alt | escape }}"
              class="shop-the-look__hero-image"
              loading="lazy"
              width="{{ section.settings.main_image.width }}"
              height="{{ section.settings.main_image.height }}"
            >
          </div>
        {% endif %}
      </div>

      {%- comment -%} ── RIGHT COLUMN: products at index 1, 3, 5, 7 (2nd, 4th, 6th, 8th) ── {%- endcomment -%}
      <div class="stl-right-col" aria-label="Products — right column">
        {% for block in section.blocks %}
          {%- assign product = block.settings.product -%}
          {%- assign col_index = forloop.index0 | modulo: 2 -%}
          {% if col_index == 1 and product != blank %}
            <article
              class="lookbook-product lookbook-product--desktop"
              {{ block.shopify_attributes }}
              aria-label="{{ product.title | escape }}"
            >
              <a
                href="{{ product.url }}"
                class="lookbook-product__image-link"
                aria-label="View {{ product.title | escape }}"
                tabindex="0"
              >
                {% if product.featured_media %}
                  <img
                    srcset="
                      {%- if product.featured_media.preview_image.width >= 300 -%}{{ product.featured_media.preview_image | image_url: width: 300 }} 300w,{%- endif -%}
                      {%- if product.featured_media.preview_image.width >= 500 -%}{{ product.featured_media.preview_image | image_url: width: 500 }} 500w,{%- endif -%}
                      {%- if product.featured_media.preview_image.width >= 800 -%}{{ product.featured_media.preview_image | image_url: width: 800 }} 800w,{%- endif -%}
                      {{ product.featured_media.preview_image | image_url }} {{ product.featured_media.preview_image.width }}w
                    "
                    src="{{ product.featured_media.preview_image | image_url: width: 500 }}"
                    sizes="(min-width: 990px) 28vw, 50vw"
                    alt="{{ product.featured_media.preview_image.alt | escape | default: product.title }}"
                    class="lookbook-product__image"
                    loading="lazy"
                    width="{{ product.featured_media.preview_image.width }}"
                    height="{{ product.featured_media.preview_image.height }}"
                  >
                {% else %}
                  <div class="lookbook-product__image-placeholder" aria-hidden="true"></div>
                {% endif %}
              </a>

              {% if block.settings.show_info %}
                <div class="shop-the-look__info lookbook-product__overlay content-container color-{{ section.settings.color_scheme | default: 'scheme-1' }} gradient">
                  <h3 class="shop-the-look__title h2" title="{{ product.title | escape }}">
                    {{ product.title }}
                  </h3>
                  <div class="shop-the-look__price">
                    {{ product.price | money }}
                  </div>
                  {% if product.selected_or_first_available_variant %}
                    <form method="post" action="{{ routes.cart_add_url }}">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <div class="card_actions-container">
                        <button
                          type="submit"
                          class="button button--primary button--full-width"
                          aria-label="Add {{ product.title | escape }} to cart"
                        >
                          Add to cart
                        </button>
                      </div>
                    </form>
                  {% endif %}
                </div>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>

    </div>{%- comment -%} end .shop-the-look__canvas--desktop {%- endcomment -%}

    {%- comment -%}
      ============================================================
      MOBILE / TABLET SLIDER  (<990px)
      ============================================================
    {%- endcomment -%}
    <div class="shop-the-look__mobile-wrapper">
      {% if section.settings.main_image != blank %}
        <div class="shop-the-look__hero shop-the-look__hero--mobile" aria-hidden="true">
          <img
            srcset="
              {%- if section.settings.main_image.width >= 375 -%}{{ section.settings.main_image | image_url: width: 375 }} 375w,{%- endif -%}
              {%- if section.settings.main_image.width >= 750 -%}{{ section.settings.main_image | image_url: width: 750 }} 750w,{%- endif -%}
              {%- if section.settings.main_image.width >= 1100 -%}{{ section.settings.main_image | image_url: width: 1100 }} 1100w,{%- endif -%}
              {{ section.settings.main_image | image_url }} {{ section.settings.main_image.width }}w
            "
            src="{{ section.settings.main_image | image_url: width: 750 }}"
            sizes="100vw"
            alt="{{ section.settings.main_image.alt | escape }}"
            class="shop-the-look__hero-image"
            loading="lazy"
            width="{{ section.settings.main_image.width }}"
            height="{{ section.settings.main_image.height }}"
          >
        </div>
      {% endif %}

      <slideshow-component class="slider-mobile-gutter" role="region" aria-label="Products in this look">
        <div
          class="shop-the-look__slider-track slider slider--mobile"
          id="Slider-{{ section.id }}"
          aria-live="polite"
        >
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- if product != blank -%}
              <div
                class="lookbook-product lookbook-product--slide slider__slide"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                role="group"
                aria-label="Product {{ forloop.index }} of {{ section.blocks.size }}: {{ product.title | escape }}"
                {{ block.shopify_attributes }}
              >
                <div class="lookbook-product__card">
                  <a href="{{ product.url }}" class="lookbook-product__link" aria-label="View {{ product.title | escape }}">
                    <div class="lookbook-product__image-wrapper">
                      {{
                        product.featured_image
                        | image_url: width: 600
                        | image_tag: loading: 'lazy', class: 'lookbook-product__image', alt: product.title
                      }}
                    </div>
                    <div class="lookbook-product__meta">
                      <span class="product-title">{{ product.title }}</span>
                      <span class="product-price" aria-label="Price: {{ product.price | money }}">{{ product.price | money }}</span>
                    </div>
                  </a>
                  <div class="lookbook-product__quick-add">
                    {%- render 'buy-buttons',
                      product: product,
                      section_id: section.id,
                      show_pickup_availability: false
                    -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="slideshow__controls slider-buttons no-js-hidden" role="group" aria-label="Slider controls">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-controls="Slider-{{ section.id }}"
            aria-label="Previous product"
          >
            <span class="svg-wrapper" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>

          <div class="slider-counter slider-counter--dots" role="group" aria-label="Slide indicators">
            <div class="slideshow__control-wrapper">
              {%- for block in section.blocks -%}
                {%- if block.settings.product != blank -%}
                  <button
                    class="slider-counter__link slider-counter__link--dots link"
                    aria-label="Go to product {{ forloop.index }}"
                    aria-controls="Slider-{{ section.id }}"
                  >
                    <span class="dot" aria-hidden="true"></span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-controls="Slider-{{ section.id }}"
            aria-label="Next product"
          >
            <span class="svg-wrapper" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      </slideshow-component>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Shop The Look",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Model Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop The Look"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Look Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "show_info",
          "label": "Show product info",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop The Look",
      "blocks": [
        { "type": "product", "settings": {} },
        { "type": "product", "settings": {} },
        { "type": "product", "settings": {} },
        { "type": "product", "settings": {} }
      ]
    }
  ]
}
{% endschema %}
